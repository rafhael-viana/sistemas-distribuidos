### Login do admin (troque pelas credenciais do seed/users.json)
# A API de e-mails só aceita o perfil admin.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "login": "admin",
  "password": "troque-esta-senha"
}

# @lang=lua
> {%
  local body = vim.json.decode(response.body)
  client.global.set("token", body.token)
%}

### Envio manual de e-mail (suporte)
POST http://localhost:8080/api/v1/notifications/email
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "to": "other@example.com",
  "subject": "Bem-vindo!",
  "body": "Olá, sua conta foi criada com sucesso."
}

# @lang=lua
> {%
  local body = vim.json.decode(response.body)
  client.global.set("id_dinamico", body.id)
%}

### Lista os e-mails enviados
GET http://localhost:8080/api/v1/notifications/email
Authorization: Bearer {{token}}

###
GET http://localhost:8080/api/v1/notifications/email/{{id_dinamico}}
Authorization: Bearer {{token}}
